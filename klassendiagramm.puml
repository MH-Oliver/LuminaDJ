@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam defaultTextAlignment center

' --- MODULE: CORE ---
package "modules.core" #F9EBEA {
    class DjSessionController {
        - sessionActive: boolean
        + startSession(entrySong: Track)
    }
}

' --- MODULE: USER CONTEXT ---
package "modules.userContext" #F4ECF7 {
    class UserContextService <<Singleton>> {
        + getCurrentContext()
    }
}

' --- MODULE: PREDICTION ---
package "modules.prediction" #E8F8F5 {
    class PredictionAggregator {
        + calculateNextAttributes(currentSong: Track, feedback: FeedbackResult): PredictedAttributes
    }

    interface PredictionStrategy <<Strategy>> {
        + getWeight(): double
        + calculate(currentTrack: Track): PredictionFactor
    }

    class HistoryStrategy implements PredictionStrategy
    class MacroCurveStrategy implements PredictionStrategy
    class LiveFeedbackAdapter implements PredictionStrategy

    class SessionHistoryRepository {
        + addEntry(track: Track, feedback: FeedbackResult)
        + getHistory()
    }

    class PredictedAttributes <<Record>> {
        + energy: double
        + bpm: double
    }
    class PredictionFactor <<Record>> {
        + energyMultiplier: double
        + bpmMultiplier: double
    }

    PredictionAggregator *-- "*" PredictionStrategy : "nutzt Liste von"

    HistoryStrategy --> SessionHistoryRepository : "liest Historie"
    MacroCurveStrategy --> UserContextService : "liest Kontext"
}

' --- MODULE: VISION ---
package "modules.vision" #FEF9E7 {
    interface LiveFeedbackStrategy <<Strategy>> {
        + startParallelEvaluation(song: Track)
        + stopAndGetResult(): FeedbackResult
    }

    class SmartphoneKameraStrategy implements LiveFeedbackStrategy

    interface DetectionStrategy <<Strategy>> {
       + analyse(BufferedImage image): FrameDataDTO
    }

    class DetectionStrategyLangChain4j implements DetectionStrategy


    SmartphoneKameraStrategy *-- "*" DetectionStrategy : "verarbeitet Bild mit"
    DetectionStrategyLangChain4j --> UserContextService : "liest Kontext"
    PredictionAggregator ..> LiveFeedbackAdapter : "fügt dynamisch hinzu"

    class FeedbackResult <<Record>> {
        + isPositiveTrend: boolean
        + intensity: double
    }
}

' --- MODULE: MUSIC ---
package "modules.music" #EBF5FB {
    interface MusicPlayerAdapter <<Strategy>> {
        + play(track: Track)
    }
    class SpotifyAdapter implements MusicPlayerAdapter

    interface MusicSourceAdapter <<Strategy>> {
        + getNextSong(target: PredictedAttributes, current: Track): Track
    }
    class ReccoBeatsAdapter implements MusicSourceAdapter

    class Track <<Record>> {
        + id: String
        + energy: double
        + bpm: double
    }
}

' --- ABHÄNGIGKEITEN DES CONTROLLERS (Dependency Injection) ---
DjSessionController --> MusicPlayerAdapter : player
DjSessionController --> LiveFeedbackStrategy : liveFeedback
DjSessionController --> PredictionAggregator : aggregator
DjSessionController --> MusicSourceAdapter : sourceAdapter

DjSessionController --> SessionHistoryRepository : speichert Feedback

@enduml