@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam defaultTextAlignment center

' --- MODULE: CORE ---
package "modules.core" #F9EBEA {
    class DjSessionController {
        - sessionActive: boolean
        + startSession(entrySong: Track)
    }
}

' --- MODULE: PREDICTION ---
package "modules.prediction" #E8F8F5 {
    class PredictionAggregator {
        + calculateNextAttributes(currentSong: Track, FeedbackResult feedback): PredictedAttributes
    }

    interface PredictionStrategy <<Strategy>> {
        + getWeight(): double
        + calculate(currentTrack: Track): PredictionFactor
    }

    class HistoryStrategyMock implements PredictionStrategy
    class MacroCurveStrategyMock implements PredictionStrategy

    class PredictedAttributes <<Record>> {
        + energy: double
        + bpm: double
    }
    class PredictionFactor <<Record>> {
        + energyMultiplier: double
        + bpmMultiplier: double
    }

    PredictionAggregator *-- "*" PredictionStrategy : "nutzt Liste von"
}

' --- MODULE: VISION ---
package "modules.vision" #FEF9E7 {
    interface LiveFeedbackStrategy <<Strategy>> {
        + startParallelEvaluation(song: Track)
        + stopAndGetResult(): FeedbackResult
    }
    class LiveFeedbackStrategyMock implements LiveFeedbackStrategy

    class FeedbackResult <<Record>> {
        + isPositiveTrend: boolean
        + intensity: double
    }
}

' --- MODULE: MUSIC ---
package "modules.music" #EBF5FB {
    interface MusicPlayerAdapter <<Strategy>> {
        + play(track: Track)
    }
    class MusicPlayerAdapterMock implements MusicPlayerAdapter

    interface MusicSourceAdapter <<Strategy>> {
        + getNextSong(target: PredictedAttributes, current: Track): Track
    }
    class MusicGraphAdapterMock implements MusicSourceAdapter

    class Track <<Record>> {
        + id: String
        + energy: double
        + bpm: double
    }
}

' --- ABHÄNGIGKEITEN DES CONTROLLERS (Dependency Injection) ---
DjSessionController --> MusicPlayerAdapter : player
DjSessionController --> LiveFeedbackStrategy : liveFeedback
DjSessionController --> PredictionAggregator : aggregator
DjSessionController --> MusicSourceAdapter : sourceAdapter

' --- DATENFLUSS (Zur Veranschaulichung) ---
DjSessionController ..> Track : verwaltet
LiveFeedbackStrategy ..> FeedbackResult : liefert
PredictionAggregator ..> PredictedAttributes : liefert
MusicSourceAdapter ..> Track : liefert

@enduml