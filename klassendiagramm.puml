@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam defaultTextAlignment center

' --- MODULE: CORE ---
package "modules.core" #F9EBEA {
    class DjSessionController {
        - sessionActive: boolean
        + startSession(entrySong: Track)
    }
}

' --- MODULE: USER CONTEXT ---
package "modules.userContext" #F4ECF7 {
    interface UserContextStrategy <<Strategy>> {
        + getUserContext(): UserContextDTO
    }

    class TimelineFactory {
        {static} + createTimelineForVibe(vibe: SessionVibe): GenreTimeline
    }

    enum SessionVibe {}

    TimelineFactory .right.> SessionVibe : nutzt
}

' --- MODULE: PREDICTION ---
package "modules.prediction" #E8F8F5 {
    class PredictionAggregator {
        + calculateNextAttributes(currentSong: Track, feedback: FeedbackResult): PredictedAttributes
    }

    interface PredictionStrategy <<Strategy>> {
        + getWeight(): double
        + calculate(currentTrack: Track): PredictionFactor
    }

    class HistoryStrategy implements PredictionStrategy
    class MacroCurveStrategy implements PredictionStrategy
    class LiveFeedbackAdapter implements PredictionStrategy

    class PredictedAttributes <<Record>> {
        + energy: double
        + bpm: double
    }

    MacroCurveStrategy --> UserContextStrategy : liest Kontext
    PredictionAggregator *-- "*" PredictionStrategy : bündelt
}

' --- MODULE: MUSIC ---
package "modules.music" #EBF5FB {
    interface MusicPlayerAdapter <<Strategy>> {
        + play(track: Track)
    }

    interface MusicSourceAdapter <<Strategy>> {
        + getNextSong(target: PredictedAttributes, current: Track): Track
    }

    class LocalSongDatabaseAdapter implements MusicSourceAdapter
    class HybridSourceAdapter implements MusicSourceAdapter

    class PlayedSongRepository {
        + markAsPlayed(trackId: String)
        + isPlayable(trackId: String, cooldown: int): boolean
    }

    class SessionHistoryRepository {
        + addEntry(track: Track, feedback: FeedbackResult)
    }

    class SessionBootstrapper {
        + generateFirstTrack(startWeights: Map): Track
    }

    class Track <<Record>> {
        + id: String
        + genre: String
    }

    LocalSongDatabaseAdapter --> PlayedSongRepository : filtert blockierte
    LocalSongDatabaseAdapter --> UserContextStrategy : liest Cooldown
    SessionBootstrapper --> LocalSongDatabaseAdapter : sucht Start-Song
}

' --- ABHÄNGIGKEITEN DES CONTROLLERS (Dependency Injection) ---
DjSessionController --> MusicPlayerAdapter : player
DjSessionController --> PredictionAggregator : aggregator
DjSessionController --> MusicSourceAdapter : sourceAdapter
DjSessionController --> SessionHistoryRepository : history
DjSessionController --> PlayedSongRepository : playedRepo

@enduml