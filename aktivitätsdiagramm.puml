@startuml
skinparam style strictuml
skinparam defaultTextAlignment center
skinparam ActivityBackgroundColor #EBF5FB
skinparam ActivityBorderColor #2980B9
skinparam NoteBackgroundColor #FDFEFE
skinparam NoteBorderColor #BDC3C7

start

:<b>Systemstart</b> (App.java);
:Wähle <b>SessionVibe</b> (z.B. Workout)
und generiere Timeline via <b>TimelineFactory</b>, oder <b>custom</b>;

:<b>SessionBootstrapper</b> berechnet perfekten
Start-Song aus den Gewichten für Minute 0.0;

repeat
  ' --- ZUSTAND: ABSPIELEN & BEOBACHTEN ---
  fork
    :<b>MusicPlayerAdapter</b>
    Zustand: Song abspielen;
  fork again
    :<b>LiveFeedbackStrategy</b>
    Zustand: Kamera wertet Publikums-Feedback
    parallel zum Song aus;
  end fork

  ' --- TRIGGER: ENDE ---
  :<i>Trigger: Song ist fast beendet</i>;

  ' --- AUSWERTUNG ---
  :Übergib bisherigen Song
  an den <b>PredictionAggregator</b>;

  partition "Auswertung & Vorhersage" {
    :Iteriere über <b>List<PredictionStrategy></b>
    (MacroCurve, History, LiveFeedback);

    :Verechne Basis-Parameter des alten Songs
    mit den Faktoren der Strategien;

    :Generiere Ziel-Vektor (<b>PredictedAttributes</b>);
  }

  ' --- NÄCHSTER SONG FINDEN ---
  partition "Song-Auswahl (LocalSongDatabaseAdapter)" {
      :Suche Top-Kandidaten in lokaler CSV;

      :<b>Cooldown-Prüfung:</b>
      Ist Song im <b>PlayedSongRepository</b> gesperrt?
      -> Falls ja: Überspringen;

      :Verteile Strafen für falsches Genre
      (Genre-Gravity) an verbleibende Kandidaten;
  }

  :Song gefunden;
  :<b>PlayedSongRepository</b> markiert
  neuen Song als gespielt;

repeat while (Session aktiv?)

stop
@enduml